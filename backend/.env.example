# Copy to .env and fill in real values. .env is gitignored.

# --- Application ---
APP_ENV=development
LOG_LEVEL=INFO

# --- Database ---
# PostgreSQL with the pgvector extension available.
DATABASE_URL=postgresql+asyncpg://factlayer:factlayer@localhost:5432/factlayer

# --- LLM provider selection ---
# One of: groq | ollama | frontier
LLM_PROVIDER=groq

# Groq (default path, free tier). Get a key at https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Ollama (local fallback, same interface)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Frontier (optional upgrade, OpenAI-compatible endpoint). Off unless configured.
FRONTIER_API_KEY=
FRONTIER_MODEL=gpt-4o
FRONTIER_BASE_URL=https://api.openai.com/v1

# Shared generation controls
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_SECONDS=60

# --- Embeddings (always local, never provider-gated) ---
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DEVICE=cpu

# --- Storage ---
UPLOAD_DIR=./storage/uploads
PAGE_IMAGE_DIR=./storage/page_images
