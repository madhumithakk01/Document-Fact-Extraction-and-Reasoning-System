# Copy to .env and fill in real values. .env is gitignored.

# --- Application ---
APP_ENV=development
LOG_LEVEL=INFO

# --- Database ---
# PostgreSQL 16+ with the pgvector extension. `docker compose up -d db` from the
# repo root starts one on host port 5433; then `python -m scripts.db upgrade`
# and, optionally, `python -m scripts.seed load` to open the app populated.
DATABASE_URL=postgresql+asyncpg://factlayer:factlayer@localhost:5433/factlayer

# --- LLM provider selection ---
# One of: groq | ollama | frontier
LLM_PROVIDER=groq
# Optional. When set and different from LLM_PROVIDER, reasoning calls fail over
# to this provider on a rate limit, timeout, auth rejection, or transport error.
# Leave blank to disable failover.
LLM_FALLBACK_PROVIDER=ollama

# Groq (default path, free tier). Get a key at https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Ollama (local fallback + dual-extraction). Pull the model first: ollama pull llama3.2:3b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Frontier (optional upgrade, OpenAI-compatible endpoint). Off unless configured.
FRONTIER_API_KEY=
FRONTIER_MODEL=gpt-4o
FRONTIER_BASE_URL=https://api.openai.com/v1

# Shared generation controls
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=6000
LLM_TIMEOUT_SECONDS=90
# stay within a free tokens-per-minute budget: in-flight request cap and spacing
LLM_MAX_CONCURRENCY=1
LLM_MIN_REQUEST_INTERVAL=2.0

# --- Independent dual-extraction corroboration ---
# off | demo_only | all. demo_only re-extracts the lowest-confidence facts (and
# any DUAL_EXTRACT_MATCH hits) on a second provider and reconciles via the precheck.
DUAL_EXTRACT_MODE=demo_only
DUAL_EXTRACT_PROVIDER=ollama
DUAL_EXTRACT_LIMIT=5
# comma-separated substrings; matching facts are always corroborated
DUAL_EXTRACT_MATCH=

# --- Embeddings (always local, never provider-gated) ---
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DEVICE=cpu

# --- Storage ---
UPLOAD_DIR=./storage/uploads
PAGE_IMAGE_DIR=./storage/page_images
